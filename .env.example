# Copia este archivo a .env y rellénalo SÓLO en local (.env está en .gitignore).
#
# Sirve para dos cosas:
#
#   1. tools/probe_camera.py lee de aquí, para no escribir los datos cada vez.
#   2. tools/check_no_secrets.py compara estos valores contra todo lo versionado
#      Y contra el mensaje de commit, y falla si alguno aparece. Es la única
#      capa que caza un valor real citado en medio de una frase.
#
# Por eso conviene rellenarlo aunque no uses la sonda, y volver a rellenarlo
# cada vez que rotes las credenciales: es el único sitio donde hay que hacerlo.
FOSCAM_HOST=192.0.2.10
FOSCAM_PORT=443
FOSCAM_USER=camera_user
FOSCAM_PASSWORD=

# La sonda no usa estos: están aquí sólo para que el detector los conozca.
FOSCAM_SSID=
FOSCAM_DDNS=

# Notas sobre qué entra en la comparación literal:
#
#   * FOSCAM_HOST y FOSCAM_PORT NO entran: ya los cazan los patrones de IP
#     privada y de puerto alto, y comparar un `443` literalmente marcaría media
#     documentación como fuga.
#   * Los valores de menos de 6 caracteres se descartan por lo mismo, pero el
#     detector avisa por stderr de cuáles ha dejado fuera: un hueco silencioso
#     es justo lo que hay que evitar.
#   * Un .env recién copiado de aquí no aporta nada al detector: reconoce sus
#     propios marcadores (192.0.2.10, camera_user) y los ignora.
