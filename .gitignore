# ---------------------------------------------------------------------------
# Secretos y datos de la instalación real. NADA de esto debe llegar a GitHub.
# ---------------------------------------------------------------------------
secrets.yaml
secrets.yml
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
credentials*
# Lista local de valores literales que nunca deben aparecer en el repo
.secret-values
*_secret*
*.secret
# ...pero el propio detector y sus pruebas sí se versionan: `*_secret*` los
# caza por el nombre, no por el contenido.
!tools/check_no_secrets.py
!tests/test_check_no_secrets.py

# Salidas de la herramienta de sondeo: contienen respuestas reales de la cámara
# (MAC, número de serie, SSID, DDNS...).
probe-*.json
probe-*.txt
tools/output/

# Manual del fabricante (documento con copyright de Foscam, no se redistribuye)
manual/

# Home Assistant
.storage/
home-assistant.log*
home-assistant_v2.db*
.HA_VERSION
config/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage*
*.egg-info/
dist/
build/

# Restos de la instalación (borrables sin miedo)
_to_delete/
*.zip

