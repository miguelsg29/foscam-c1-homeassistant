  "services": {
    "cgi_command": {
      "name": "Run CGI command",
      "description": "Sends any read or write command to the camera's CGI API and returns the parsed response.",
      "fields": {
        "device_id": {
          "name": "Camera",
          "description": "The Foscam camera to talk to."
        },
        "command": {
          "name": "Command",
          "description": "CGI command name, for example getDevState."
        },
        "params": {
          "name": "Parameters",
          "description": "Extra query parameters as key/value pairs."
        }
      }
    },
    "set_motion_config": {
      "name": "Set motion detection settings",
      "description": "Changes individual motion detection fields, keeping every other setting intact.",
      "fields": {
        "device_id": {
          "name": "Camera",
          "description": "The Foscam camera to configure."
        },
        "params": {
          "name": "Fields",
          "description": "Fields to change, for example sensitivity or triggerInterval."
        }
      }
    },
    "snapshot": {
      "name": "Save snapshot",
      "description": "Asks the camera for a still image and writes it to a file.",
      "fields": {
        "device_id": {
          "name": "Camera",
          "description": "The Foscam camera to snapshot."
        },
        "filename": {
          "name": "File name",
          "description": "Full path, which must be inside allowlist_external_dirs."
        }
      }
    }
